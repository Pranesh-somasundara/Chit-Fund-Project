table Measure_Table
	lineageTag: ae136df2-fc51-489d-a723-acd7ab647476

	measure 'New Loan' =
			
			SUM(Fact_LoanTransaction[Loan])
		formatString: 0
		lineageTag: fdbcf808-13df-4d8f-9013-c8461ad70be7

	measure 'Total Loan Refund' =
			
			SUM(Fact_LoanTransaction[Loan_Refund])
		formatString: 0
		lineageTag: 581be140-5af9-441e-8c3b-fd866d8c408e

	measure 'Interest Paid' =
			
			SUM(Fact_LoanTransaction[Interest_Paid])
		formatString: 0
		lineageTag: d50310be-1cf0-4469-80b0-18144fee24df

	measure 'Outstanding Loan' =
			
			[New Loan] - [Total Loan Refund]
		formatString: 0
		lineageTag: f4bfd622-30ce-4407-9095-d42fb108c757

	measure 'Current Interest' =
			
			[Closing Loan] *
			SELECTEDVALUE(Dim_Chit[Loan_Interest_Rate])
		lineageTag: 03079b54-d2ad-4ae0-87cc-6220bb3eec27

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Closing Loan' =
			
			VAR CurrentDate =
			    MAX(Dim_Calendar[Date])
			
			VAR CumulativeLoan =
			    CALCULATE(
			        [New Loan],
			        FILTER(
			            ALL(Dim_Calendar[Date]),
			            Dim_Calendar[Date] <= CurrentDate
			        )
			    )
			
			VAR CumulativeRefund =
			    CALCULATE(
			        [Total Loan Refund],
			        FILTER(
			            ALL(Dim_Calendar[Date]),
			            Dim_Calendar[Date] <= CurrentDate
			        )
			    )
			
			RETURN
			    CumulativeLoan - CumulativeRefund
		formatString: 0
		lineageTag: 42e06f6e-4a1c-4a10-ab32-70c0eac1abc3

	measure 'Total Deposit' =
			
			SUMX(
			    Fact_Deposit,
			    Fact_Deposit[Number_Of_Deposit] *
			    RELATED(Dim_Chit[Deposit_Amount])
			)
		formatString: "₹"\ #,0.###############;#,0.###############\ -"₹";"₹"\ #,0.###############
		lineageTag: 3b6063b7-43a9-4fde-8b12-bf238fa9ecbd

		annotation PBI_FormatHint = {"currencyCulture":"en-IN"}

	measure 'Chit Interest' =
			
			[Total Deposit] *
			MAX(Dim_Chit[Chit_Interest_Rate])
		formatString: #,0
		lineageTag: 05e06998-9ad5-4855-9305-1bb84af2b380

	measure 'Maturity Amount' =
			
			[Total Deposit] + [Chit Interest]
		formatString: "₹"\ #,0.###############;#,0.###############\ -"₹";"₹"\ #,0.###############
		lineageTag: 0f05c240-6f62-4fb2-b67a-518cee9f52ca

		annotation PBI_FormatHint = {"currencyCulture":"en-IN"}

	measure 'Opening Loan' =
			
			VAR CurrentDate =
			    MIN(Dim_Calendar[Date])
			
			VAR PreviousDate =
			    EOMONTH(CurrentDate, -1)
			
			RETURN
			    COALESCE(
			        CALCULATE(
			            [Closing Loan],
			            FILTER(
			                ALL(Dim_Calendar),
			                Dim_Calendar[Date] <= PreviousDate
			            )
			        ),
			        0
			    )
		formatString: "₹"\ #,0.###############;#,0.###############\ -"₹";"₹"\ #,0.###############
		lineageTag: 15c4f82b-1f87-421f-a6de-a4b60938ae28

		annotation PBI_FormatHint = {"currencyCulture":"en-IN"}

	measure 'Loan Interest Due' =
			
			[Current Interest]
		formatString: "₹"\ #,0.###############;#,0.###############\ -"₹";"₹"\ #,0.###############
		lineageTag: e7cac4b8-22f5-4e04-a138-da0863692e97

		annotation PBI_FormatHint = {"currencyCulture":"en-IN"}

	measure 'Total Members' =
			
			DISTINCTCOUNT(Dim_Customer[Member_ID])
		formatString: 0
		lineageTag: 06fada85-7279-4c61-a8f5-7840011fb0a6

	measure 'Total Loans Given' =
			
			[New Loan]
		formatString: #,0
		lineageTag: 3c1f58da-2230-4e16-b2b9-de88f0912646

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Current Outstanding Loan' =
			
			[Closing Loan]
		formatString: "₹"\ #,0.###############;#,0.###############\ -"₹";"₹"\ #,0.###############
		lineageTag: ea7e3138-4872-4b76-b32a-2d161049538d

		annotation PBI_FormatHint = {"currencyCulture":"en-IN"}

	measure 'Total Interest Paid' =
			
			[Interest Paid]
		formatString: "₹"\ #,0.###############;#,0.###############\ -"₹";"₹"\ #,0.###############
		lineageTag: e46eb1e4-e8e7-4c20-a0f8-2e3d31c1456d

		annotation PBI_FormatHint = {"currencyCulture":"en-IN"}

	measure 'total number of deposits' =
			
			sum(Fact_Deposit[Number_Of_Deposit])
		formatString: 0
		lineageTag: bc5a4ec5-a060-41a6-83c8-c36a625c84e1

	measure 'Total Chit Value' =
			
			SUMX(
			    Fact_Deposit,
			    Fact_Deposit[Number_Of_Chit] *
			    RELATED(
			        Dim_Chit[Chit_Amount])
			)
		formatString: 0
		lineageTag: bff07f67-a1a2-42aa-a882-4bcf21cb0b7d

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Previous Month Interest' =
			
			VAR CurrentDate =
			    MAX(Dim_Calendar[Date])
			
			VAR PreviousMonthStart =
			    DATE(
			        YEAR(CurrentDate),
			        MONTH(CurrentDate) - 1,
			        1
			    )
			
			VAR PreviousMonthEnd =
			    EOMONTH(CurrentDate, -1)
			
			RETURN
			    CALCULATE(
			        [Current Interest],
			        REMOVEFILTERS(Dim_Calendar),
			        DATESBETWEEN(
			            Dim_Calendar[Date],
			            PreviousMonthStart,
			            PreviousMonthEnd
			        )
			    )
		lineageTag: 41069160-82be-4e2f-a47b-8e69db5333bd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'selected Year' =
			
			IF(
			    HASONEVALUE(Dim_Calendar[Year]),
			    FORMAT(
			        SELECTEDVALUE(Dim_Calendar[Year]),
			        "0"
			    ),
			    "All Year"
			)
		lineageTag: 5995dc34-0429-48b5-abca-9a41d72c611e

	measure 'Selected Month' =
			
			if(
			    HASONEVALUE(Dim_Calendar[Month]),
			        FORMAT(
			            SELECTEDVALUE(Dim_Calendar[Month]),
			            "MMMM"
			            ),
			            "All Months "
			
			)
		lineageTag: a5114af3-3c4e-4faf-97fd-9678aff78796

	measure 'Previous month interest_1' =
			
			CALCULATE(
			    [Total Interest Paid],
			    DATEADD(
			        Dim_Calendar[Date],
			        -1,
			        MONTH
			    )
			)
		formatString: "₹"\ #,0.###############;#,0.###############\ -"₹";"₹"\ #,0.###############
		lineageTag: 728370ef-46db-4499-9444-15a5aa6a12b0

		annotation PBI_FormatHint = {"currencyCulture":"en-IN"}

	measure 'Entire Deposite''s interest' =
			
			Chit_
		lineageTag: 34e1589e-872a-492b-8a12-7181f360cf2b

	measure 'Chit Interest Display (Entire Depsoites interest)' =
			
			FORMAT(
			    [Chit Interest],
			    "#,##0"
			)
		lineageTag: c0e8a286-6098-404e-9ea4-b4e0b4ce539d

	column Value
		lineageTag: 9831ced4-146b-45ba-beac-80a3c2406e8c
		summarizeBy: none
		isNameInferred
		sourceColumn: [Value]

		annotation SummarizationSetBy = Automatic

	partition Measure_Table = calculated
		mode: import
		source = {""}

	annotation PBI_Id = ec97a9268494428981d9158f9c7eb444

